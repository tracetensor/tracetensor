# TraceTensor backend configuration.
# Copy this file to `.env` in the SAME directory (backend/.env) and fill in
# values. The app loads backend/.env automatically at startup. Never commit .env.
#
# Every <NAME> below also accepts <NAME>_FILE=/path/to/secret-file (Docker-secrets
# convention) — the value is read from that file instead, so it never appears in
# the process environment / `docker inspect`. Prefer *_FILE in production.

# --- Database ---------------------------------------------------------------
# Postgres (default; matches docker-compose):
DATABASE_URL=postgresql+asyncpg://tracetensor:tracetensor@localhost:5432/tracetensor
# Or, for a zero-Postgres local run, use SQLite instead:
# DATABASE_URL=sqlite+aiosqlite:///./tracetensor.db

# Connection pool budget (Postgres only). Keep POOL_SIZE + MAX_OVERFLOW under
# the server's max_connections; put PgBouncer in front for many app instances.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# Where uploaded task directories are stored on disk:
TASKS_ROOT=./_tasks

# Comma-separated origins allowed by CORS (frontend dev servers):
CORS_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:3000

# --- Access control -----------------------------------------------------------
# Optional shared secret. UNSET (default) = no auth, fine for localhost/dev.
# SET the moment the API is reachable beyond localhost — every mutating/execute
# endpoint then requires `Authorization: Bearer <token>` or `X-API-Key: <token>`.
# Without this, anyone who can reach the port can start jobs that spend your
# LLM budget.
API_TOKEN=

# Rate limit for job-creating endpoints (requests/min per client). 0 = off.
RATE_LIMIT_PER_MINUTE=0

# --- Job queue / workers -------------------------------------------------------
# True (default): the API process also runs a worker (zero-config single node).
# False: run standalone workers elsewhere (`python -m app.worker`) to scale
# execution across machines.
# WORKER_EMBEDDED=true
# WORKER_CONCURRENCY=4
# WORKER_POLL_INTERVAL=0.5
# WORKER_LEASE_TIMEOUT=180
# WORKER_HEARTBEAT_INTERVAL=20
# WORKER_ID=
# WORKER_DRAIN_TIMEOUT=30

# --- LLM provider keys (only needed to run agents) --------------------------
# A provider appears as "available" in the UI only when its key is set.
# Leave blank to disable that provider.

# Anthropic (Claude) -> built-in loop agent "anthropic"; also used by the
# "mini-swe" / "claude-code" installed agents when their model is Anthropic's.
ANTHROPIC_API_KEY=

# OpenAI (GPT) -> built-in loop agent "openai"; also used by the "codex"
# installed agent, and as the default judge model for llm-judge verifiers.
OPENAI_API_KEY=

# OpenRouter (any model, OpenAI-compatible) -> agent "openrouter"; can also
# drive "mini-swe" with a model id like "openrouter/google/gemini-2.5-flash".
OPENROUTER_API_KEY=

# --- Cloud execution backends (Phase 0 preflight; Phase 1 runs trials) ---------
# Optional cloud sandbox SDKs (install only what you use):
#   pip install daytona
# Preflight: tracetensor backends preflight daytona

# DAYTONA_API_KEY=
# E2B_API_KEY=
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# RUNLOOP_API_KEY=
# NOVITA_API_KEY=

# --- Diagnose (docs/DIAGNOSE.md) -----------------------------------------------
# Rule-based "why did this trial fail" classification. Free, offline, on by
# default; annotates trajectory.failure_analysis without touching the grade.
# DIAGNOSE_ENABLED=true
# The LLM extraction tier costs one model call per failed trial — opt-in.
# DIAGNOSE_LLM_ENABLED=false
# provider/model for the extractor (default openai/gpt-4.1-mini).
# DIAGNOSE_MODEL=openai/gpt-4.1-mini
