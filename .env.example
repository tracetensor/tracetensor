# TraceTensor environment — copy this to .env and fill in the values.
# Never commit .env to git (it is gitignored).

# ── Database ──────────────────────────────────────────────────────────────────
# Change these before any networked deployment.
POSTGRES_USER=tracetensor
POSTGRES_PASSWORD=changeme   # generate: openssl rand -hex 20
POSTGRES_DB=tracetensor

# ── Access control ────────────────────────────────────────────────────────────
# REQUIRED for any deployment reachable beyond localhost.
# Without this, the API is fully open — anyone who can reach port 8000 can
# create jobs that spend your LLM budget.
# Generate: openssl rand -hex 32
API_TOKEN=

# ── LLM provider keys ─────────────────────────────────────────────────────────
# Leave blank to disable that provider. At least one is needed to run agents.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── Optional: rate limiting ───────────────────────────────────────────────────
# Jobs per client per minute. Default is 60. Set 0 to disable (not recommended).
# RATE_LIMIT_PER_MINUTE=60

# ── Optional: worker tuning ───────────────────────────────────────────────────
# WORKER_EMBEDDED=true
# WORKER_CONCURRENCY=4

# ── Optional: agent budgets ───────────────────────────────────────────────────
# Per-TRIAL ceilings handed to agents that accept them. Per trial, not per job:
# a 20-trial job can spend up to 20x AGENT_COST_LIMIT_USD.
# AGENT_COST_LIMIT_USD=1.0
# AGENT_MAX_TURNS=40          # installed agents that take a turn cap
# LLM_AGENT_MAX_STEPS=12      # commands the built-in bash loop may run

# ── Optional: Docker platform (Apple Silicon) ───────────────────────────────
# Default on arm64 Mac: linux/amd64 (emulation for amd64-only eval images).
# Set native to use the host platform instead.
# TRACETENSOR_DOCKER_PLATFORM=linux/amd64
# TRACETENSOR_DOCKER_PLATFORM=native

# ── Optional: infra retries ─────────────────────────────────────────────────
# Re-run a trial once when setup/Docker fails before the agent starts (not LLM).
# TRACETENSOR_INFRA_RETRIES=1

# ── Optional: Harbor Hub registry ─────────────────────────────────────────────
# Direct Supabase registry API (no Harbor CLI). Public tasks work without auth.
# TRACETENSOR_REGISTRY_URL=https://ofhuhcpkvzjlejydnvyd.supabase.co
# TRACETENSOR_REGISTRY_CACHE=~/.cache/tracetensor/registry
# TRACETENSOR_REGISTRY_TOKEN=   # private packages (future)

# ── Optional: custom agents (DANGEROUS) ───────────────────────────────────────
# Lets the API instantiate an agent class by import path ("mypkg.agents:MyAgent").
# That is arbitrary code execution in the server process. Only enable it where
# you control every caller — never on a networked instance.
# ALLOW_CUSTOM_AGENTS=false

# ── Optional: live-progress event log ────────────────────────────────────────
# Progress events are stored in the `job_events` table so any web process can
# serve the stream for a job running on any worker machine. Rows older than this
# are pruned at startup and on each worker's lease sweep.
# EVENT_RETENTION_SECONDS=86400
